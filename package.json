{
  "name": "lithium",
  "version": "0.3.10",
  "description": "Lithium — UI for Claude Code",
  "author": "Laurens Kosters",
  "license": "CC-BY-NC-4.0",
  "main": "main.js",
  "productName": "Lithium",
  "scripts": {
    "test": "node scripts/test.js",
    "start": "npx electron .",
    "rebuild": "npx @electron/rebuild",
    "postinstall": "node scripts/patch-electron-name.js && electron-rebuild -w better-sqlite3",
    "build": "npx electron-builder --mac",
    "build:win": "npx electron-builder --win",
    "build:linux": "npx electron-builder --linux",
    "build:all": "npx electron-builder --mac --win --linux"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.278",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^11.10.0",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "markdown-it": "^14.3.2",
    "node-pty": "^1.0.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "jsdom": "^26.1.0"
  },
  "build": {
    "appId": "com.lithium.app",
    "productName": "Lithium",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "category": "Development"
    },
    "files": [
      "main.js",
      "src/**/*",
      "public/**/*",
      "music/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [],
    "asar": true,
    "artifactName": "Lithium-${version}-${os}-${arch}.${ext}"
  }
}
